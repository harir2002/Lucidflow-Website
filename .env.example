# LucidFlow Website - Environment Variables
# Copy this file to .env and fill in your values
# DO NOT commit .env - it's in .gitignore

# =============================================================================
# Supabase Configuration
# =============================================================================
# Get these from Supabase Dashboard → Settings → API
# See docs/supabase-frontend-setup.md for detailed instructions

# Supabase Project URL
# Example: https://your-project.supabase.co
VITE_SUPABASE_URL=

# Supabase Publishable Key (safe to expose in browser with RLS)
# Example: eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
VITE_SUPABASE_PUBLISHABLE_KEY=

# Enquiry Form Submission Endpoint
# Points to your Supabase Edge Function (secure backend)
# Example: https://your-project.supabase.co/functions/v1/lucidflow-enquiry
VITE_LUCIDFLOW_ENQUIRY_ENDPOINT=

# =============================================================================
# Optional: Google Analytics 4
# =============================================================================
# Measurement ID from GA4 property
# Example: G-XXXXXXXXXX
VITE_GA_MEASUREMENT_ID=

# =============================================================================
# Optional: Cloudflare Turnstile
# =============================================================================
# Site key for captcha (public)
# Example: 1x00000000000000000000AA
VITE_TURNSTILE_SITE_KEY=

# =============================================================================
# Optional: Calendar Integration
# =============================================================================
# Calendar booking URL (Calendly, Microsoft Bookings, etc.)
# Example: https://calendly.com/your-link
VITE_CALENDAR_BOOKING_URL=

# =============================================================================
# Site Configuration
# =============================================================================
# Used for canonical URLs and Open Graph meta tags
# Example: https://lucidflow.sbainfosolutions.com
VITE_SITE_URL=https://www.sbainfo.in

