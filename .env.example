# LucidFlow Website - Environment Variables

# Google Analytics 4 Measurement ID
# Example: G-XXXXXXXXXX
# Leave empty to disable analytics
VITE_GA_MEASUREMENT_ID=

# Enquiry Form Submission Endpoint
# This should point to your secure backend API or serverless function
# Example: https://api.yourdomain.com/v1/lucidflow/enquiry
# Leave empty in development to use mock mode
VITE_LUCIDFLOW_ENQUIRY_ENDPOINT=

# Calendar Booking URL (optional)
# TODO: Add Calendly, Microsoft Bookings, or Google Calendar URL
# after SBA privacy and consent processes permit it
VITE_CALENDAR_BOOKING_URL=

# Site URL (for canonical URLs and Open Graph)
# Example: https://lucidflow.sbainfosolutions.com
VITE_SITE_URL=https://www.sbainfo.in
